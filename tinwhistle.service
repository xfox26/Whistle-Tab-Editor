[Unit]
Description=Tin Whistle Live API & Community Server
After=network.target

[Service]
Type=simple
# Importante: garantir `sudo chown -R www-data:www-data /var/data/tinwhistle` na VPS antes de reiniciar
User=www-data
Group=www-data
WorkingDirectory=/var/www/tinwhistle.live
ExecStart=/usr/bin/node /var/www/tinwhistle.live/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
