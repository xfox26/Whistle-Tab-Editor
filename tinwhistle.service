[Unit]
Description=Tin Whistle Live API & Community Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/tinwhistle.live
ExecStart=/usr/bin/node /var/www/tinwhistle.live/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
